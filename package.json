{
  "name": "@hlw-mp/vue",
  "version": "2.5.6",
  "description": "hlw-uni工具集",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./src/style.css",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "publish:npm": "pnpm build && npm publish --access public"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "pinia": ">=2.0.0",
    "vue": ">=3.4.0"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.30",
    "@dcloudio/uni-app": "3.0.0-5000720260410001",
    "@types/crypto-js": "^4.2.2",
    "@types/md5": "^2.3.6",
    "@types/node": "^20.19.39",
    "@vitejs/plugin-vue": "^5.2.4",
    "pinia": "^2.3.1",
    "typescript": "^4.9.5",
    "vite": "5.2.8",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.34"
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "jsencrypt": "^3.5.4",
    "md5": "^2.3.0",
    "z-paging": "^2.8.8"
  }
}